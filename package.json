{
  "name": "@cplieger/actions",
  "version": "2.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -project tsconfig.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@cplieger/fetch": "^2.1.0",
    "@cplieger/reactive": "^1.2.5"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.15.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.6",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "description": "Declarative async UI-action framework for TypeScript",
  "license": "Apache-2.0",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/actions.git"
  },
  "homepage": "https://github.com/cplieger/actions",
  "bugs": {
    "url": "https://github.com/cplieger/actions/issues"
  },
  "author": "cplieger <917744+cplieger@users.noreply.github.com>",
  "keywords": [
    "actions",
    "async",
    "optimistic-updates",
    "rollback",
    "retry",
    "dedupe",
    "polling",
    "loading-state",
    "typescript"
  ],
  "files": [
    "src/",
    "jsr.json",
    "!src/**/*.test.ts",
    "!src/**/*-setup.ts",
    "!src/**/test-helpers/**"
  ]
