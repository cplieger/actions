{
  "name": "@cplieger/actions",
  "version": "2.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -project tsconfig.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@cplieger/fetch": "2.0.0",
    "@cplieger/reactive": "1.2.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "fast-check": "4.9.0",
    "happy-dom": "20.10.6",
    "prettier": "3.9.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "description": "Declarative async UI-action framework for TypeScript",
  "license": "GPL-3.0-or-later",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplieger/actions.git"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/__test-helpers__",
    "!src/**/fc-strict-setup.ts",
    "jsr.json"
  ]
}
